# Скопируйте в .env.local и заполните нужное.
# .env.local не попадает в git.

# Адрес серверного генератора черновиков.
# Основной вариант — Cloudflare Pages Functions + Workers AI.
# Если не задан, сайт обращается к /api/generate.php на своём домене.
VITE_AI_ENDPOINT=https://alma-ai-73x.pages.dev/api/generate

# Демо-режим без сервера: заранее заготовленные задания.
# Включайте только локально, не в production-сборке.
# VITE_AI_MOCK=1
